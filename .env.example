# Copy to .env and replace with a long, random value (32+ characters).
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
NODE_ENV=development

# Use a mounted persistent disk path in production (for example /var/data).
DATA_DIR=./data

# Set true only when the hosting platform terminates HTTPS at a trusted proxy.
TRUST_PROXY=false
